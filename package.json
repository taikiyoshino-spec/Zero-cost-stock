{
  "name": "zero-cost-stock",
  "version": "1.0.0",
  "description": "恩株管理ツール - Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create zero-cost-stock-db",
    "db:migration:new": "wrangler d1 migrations create zero-cost-stock-db",
    "db:migrate": "wrangler d1 migrations apply zero-cost-stock-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply zero-cost-stock-db --local",
    "db:migrations:status": "wrangler d1 migrations list zero-cost-stock-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.95.0"
  }
}
